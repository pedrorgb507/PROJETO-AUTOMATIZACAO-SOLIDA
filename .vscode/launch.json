{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "CTP: vigiar a pasta do dia",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}\run_ctp.py",
      "console": "integratedTerminal",
      "justMyCode": true,
      "cwd": "${workspaceFolder}"
    },
    {
      "name": "CTP: arquivo aberto agora",
      "type": "debugpy",
      "request": "launch",
      "program": "${file}",
      "console": "integratedTerminal",
      "justMyCode": true,
      "cwd": "${workspaceFolder}",
      "env": { "PYTHONPATH": "${workspaceFolder}\src" }
    }
  ]
}
